# Room e enums usados nos TypeConverters
-keep @androidx.room.Entity class *
-keep class * extends androidx.room.RoomDatabase
-keepclassmembers enum * {
    public static **[] values();
    public static ** valueOf(java.lang.String);
}
-keep @androidx.room.TypeConverter class *

# Application e componentes declarados no manifest
-keep class com.example.cartelinha.CartelinhaApp { *; }
-keep class com.example.cartelinha.MainActivity { *; }
-keep class com.example.cartelinha.notifications.** { *; }